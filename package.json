{
  "name": "website-builder",
  "version": "1.0.0",
  "description": "Visual website builder with project management",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/db',{recursive:true}); fs.copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cookie-parser": "^1.4.7",
    "better-sqlite3": "^9.4.3",
    "bcryptjs": "^2.4.3",
    "express-session": "^1.18.0",
    "connect-sqlite3": "^0.9.15",
    "csurf": "^1.11.0",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "zod": "^3.22.4",
    "slugify": "^1.6.6",
    "archiver": "^7.0.1",
    "mime-types": "^2.1.35",
    "alpinejs": "^3.13.7",
    "sortablejs": "^1.15.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/express": "^4.17.21",
    "@types/cookie-parser": "^1.4.10",
    "@types/better-sqlite3": "^7.6.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/express-session": "^1.18.0",
    "@types/csurf": "^1.11.5",
    "@types/archiver": "^6.0.2",
    "@types/mime-types": "^2.1.4",
    "@types/sortablejs": "^1.15.8",
    "@types/multer": "^1.4.11",
    "@types/connect-sqlite3": "^0.9.6",
    "typescript": "^5.4.5",
    "tsx": "^4.7.2",
    "vitest": "^1.5.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@types/express-serve-static-core": "4.19.9"
  }
}